#!/usr/bin/env bash
#
# aac-patch-tree -- apply / revert the DaVinci Resolve AAC fix on a Resolve tree.
#
# Works on ANY directory laid out like a Resolve install root (one containing
# bin/resolve and libs/): a live install such as /opt/resolve, or an unpacked or
# staged tree from an installer.  It knows nothing about sudo, .deb files or
# installers -- that orchestration lives in the `aac-fix` wrapper.
#
# Blackmagic gates AAC in two places, so the fix has two halves:
#   1. bin/resolve  -- fully-additive binary patch (e9patch) un-gating the AAC
#      paths (QuickTime + Matroska) and routing them to FFmpeg
#   2. libs/libav*  -- Blackmagic's bundled FFmpeg has the AAC decoder compiled
#      OUT; we drop in AAC-enabled builds with identical sonames
#
# Usage:
#   aac-patch-tree apply  [--originals keep|remove] [--no-mkv] [-v] <ROOT>
#   aac-patch-tree revert <ROOT>
#   aac-patch-tree status <ROOT>
#
# --originals keep    (default) leave the untouched originals in the tree as
#                     bin/resolve.aac-orig and libs/_bmd_orig/, so `revert`
#                     can restore them in place.  Use for a live install.
# --originals remove  patch without leaving originals behind.  Use when staging
#                     a package: the backups would add ~670MB of dead weight,
#                     and reverting a packaged install means reinstalling the
#                     stock package.  `revert` will not work afterwards.
#
set -euo pipefail

SELF="$(readlink -f "$0")"
PKG="$(cd "$(dirname "$SELF")" && pwd)"
REPO="$PKG"

if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && \
   [ -z "${AAC_ALLOW_ENV_OVERRIDE:-}" ]; then
    for _v in AAC_E9TOOL AAC_TRAMPOLINE AAC_LIBS AAC_LOCK_FILE AAC_TEST_FAKE_PATCH AAC_TEST_FAIL_AFTER AAC_TEST_KILL_AFTER; do
        if [ -n "$(eval "printf '%s' \"\${$_v:-}\"")" ]; then
            printf '\033[33m[warn]\033[0m ignoring %s (running as root via sudo)\n' "$_v" >&2
            unset "$_v"
        fi
    done
    unset _v
fi

E9TOOL="${AAC_E9TOOL:-$REPO/vendor/e9patch/e9tool}"
TRAMPOLINE="${AAC_TRAMPOLINE:-$REPO/vendor/aacadd}"
LIBS_SRC="${AAC_LIBS:-$REPO/prebuilt/ffmpeg-aac}"
PYLIBS="$REPO/vendor/pylibs"
KEEP=keep
MKV=1
VERBOSE=0
JSON=0
REQUIRE_ACTIVE=0
PYTHON=""
LOCK_FILE=""
NO_LOCK=0

die()  { printf '\033[31m[error]\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[33m[warn]\033[0m %s\n' "$*" >&2; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

verify_payload() {
    local manifest="$REPO/SHA256SUMS"
    [ -f "$manifest" ] || {
        warn "no SHA256SUMS manifest; payload integrity unverified"
        return 0
    }
    ( cd "$REPO" && sha256sum --quiet -c SHA256SUMS ) >/dev/null 2>&1 || \
        die "payload checksum mismatch against $manifest --
       vendor/ or prebuilt/ has been modified.  Refusing to patch.
       (Run 'sha256sum -c SHA256SUMS' in $REPO to see which file.)"
}

pick_python() {
    local p
    for p in "$REPO/.venv/bin/python" python3; do
        command -v "$p" >/dev/null 2>&1 || continue
        if PYTHONPATH="$PYLIBS" "$p" -c 'import capstone, elftools' >/dev/null 2>&1; then
            printf '%s' "$p"
            return 0
        fi
    done
    die "need python3 with the 'capstone' and 'pyelftools' modules
       (they are vendored in release tarballs under vendor/pylibs; from a git
       checkout run: pip install capstone pyelftools)"
}

preflight() {
    need_cmd flock
    need_cmd sha256sum
    if [ "${AAC_TEST_FAKE_PATCH:-0}" = 1 ]; then
        PYTHON="$(command -v python3)" || die "missing required command: python3"
        return
    fi
    [ -x "$E9TOOL" ]     || die "e9tool not found/executable: $E9TOOL"
    [ -e "$TRAMPOLINE" ] || die "trampoline not found: $TRAMPOLINE"
    [ -d "$LIBS_SRC" ]   || die "AAC FFmpeg libs not found: $LIBS_SRC"
    verify_payload
    PYTHON="$(pick_python)"
}

status_preflight() {
    need_cmd flock
    need_cmd python3
    PYTHON="$(command -v python3)"
}

run_python() {
    env "PYTHONPATH=$REPO:$PYLIBS" "$PYTHON" -m aacpatch.lifecycle "$@"
}

run_locked() {
    local mode="$1"
    shift
    local lock_target="$ROOT"
    if [ -n "$LOCK_FILE" ]; then
        lock_target="$LOCK_FILE"
    elif [ -n "${AAC_LOCK_FILE:-}" ]; then
        lock_target="$AAC_LOCK_FILE"
        local lock_parent="${lock_target%/*}"
        [ "$lock_parent" = "$lock_target" ] && lock_parent="."
        [ -d "$lock_parent" ] || die "lock directory not found: $lock_parent"
        if [ -L "$lock_target" ] || { [ -e "$lock_target" ] && [ ! -f "$lock_target" ]; }; then
            die "lock file is not a regular file: $lock_target"
        fi
        [ -e "$lock_target" ] || touch -- "$lock_target" || \
            die "cannot create lock file: $lock_target"
    fi
    local -a command=(env "PYTHONPATH=$REPO:$PYLIBS" "$PYTHON" -m aacpatch.lifecycle "$@")
    flock "--$mode" "$lock_target" "${command[@]}"
}

usage() {
    local number=0 line
    while IFS= read -r line; do
        number=$((number + 1))
        [ "$number" -ge 3 ] || continue
        case "$line" in
            '# '*) printf '%s\n' "${line#\# }" ;;
            '#'*) printf '%s\n' "${line#\#}" ;;
            *) break ;;
        esac
    done < "$SELF"
    exit "${1:-0}"
}

main() {
    local cmd="${1:-}"
    shift || true
    local root=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --originals)
                [ $# -ge 2 ] || die "--originals needs an argument (keep|remove)"
                KEEP="$2"; shift 2
                [ "$KEEP" = keep ] || [ "$KEEP" = remove ] || \
                    die "--originals must be keep|remove" ;;
            --keep-originals)   KEEP=keep;   shift ;;
            --remove-originals) KEEP=remove; shift ;;
            --lock-file)
                [ $# -ge 2 ] || die "--lock-file needs an argument"
                LOCK_FILE="$2"; shift 2 ;;
            --no-lock) NO_LOCK=1; shift ;;
            --no-mkv)  MKV=0; shift ;;
            --json) JSON=1; shift ;;
            --require-active) REQUIRE_ACTIVE=1; shift ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -h|--help) usage 0 ;;
            --*) die "unknown option: $1" ;;
            *) [ -z "$root" ] || die "only one Resolve root may be given"; root="$1"; shift ;;
        esac
    done
    case "$cmd" in
        -h|--help|help|"") usage 0 ;;
        apply|revert|status) ;;
        *) die "unknown subcommand: $cmd (try --help)" ;;
    esac
    [ -n "$root" ] || die "no Resolve root given (see --help)"
    [ -d "$root" ] || die "not a directory: $root"
    root="$(readlink -f "$root")"
    ROOT="$root"
    case "$cmd" in
        apply|revert) preflight ;;
        status) status_preflight ;;
        -h|--help|help|"") usage 0 ;;
        *) die "unknown subcommand: $cmd (try --help)" ;;
    esac
    local -a args=("$cmd" "$ROOT" --originals "$KEEP" --libs "$LIBS_SRC" --repo "$REPO" \
        --pylibs "$PYLIBS" --patch-python "$PYTHON" --e9tool "$E9TOOL" \
        --trampoline "$TRAMPOLINE")
    [ "$MKV" -eq 0 ] && args+=(--no-mkv)
    [ "$VERBOSE" -eq 1 ] && args+=(--verbose)
    [ "$JSON" -eq 1 ] && args+=(--json)
    [ "$REQUIRE_ACTIVE" -eq 1 ] && args+=(--require-active)
    if [ "${AAC_TEST_FAKE_PATCH:-0}" = 1 ]; then
        args+=(--fake-patch)
        [ -z "${AAC_TEST_FAIL_AFTER:-}" ] || args+=(--fail-after-commit "$AAC_TEST_FAIL_AFTER")
    fi
    case "$cmd" in
        apply|revert)
            if [ "$NO_LOCK" -eq 1 ]; then run_python "${args[@]}"; else run_locked exclusive "${args[@]}"; fi ;;
        status)
            if [ "$NO_LOCK" -eq 1 ]; then run_python "${args[@]}"; else run_locked shared "${args[@]}"; fi ;;
    esac
}

main "$@"
